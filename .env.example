# Public URL of the site, used for canonical links and Open Graph.
NEXT_PUBLIC_SITE_URL=https://talepuff.com

# Plan checkout on Lemon Squeezy. Unset until the store exists; the pricing page then
# shows "buy in the app" instead of a checkout button.
NEXT_PUBLIC_LEMONSQUEEZY_MONTHLY_URL=
NEXT_PUBLIC_LEMONSQUEEZY_YEARLY_URL=

# The waitlist and contact forms send one email per submission over SMTP (Hostinger, same
# names as the CentProof site). Leave unset and the forms fall back to a mailto link.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=hello@talepuff.com
MAIL_PASSWORD=
SUPPORT_INBOX=hello@talepuff.com
